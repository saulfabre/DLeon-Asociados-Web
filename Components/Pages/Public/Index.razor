@page "/"

@rendermode InteractiveServer

<div class="container">
    @*Header*@
    <header class="header">
        @*Logo*@
        <a href="/">
            <img src="/images/bwm-2.svg">
        </a>

        @*Navegación de la página...*@
        <nav class="nav-bar">
            <a href="">Inicio</a>
            <a href="">Vehículos</a>
            <a href="">Nosotros</a>
            <a href="">Contáctanos</a>
        </nav>

        @*Botón para navegar a login*@
        <a class="login-button" href="/login">Acceso</a>
    </header>

    <div class="hero-section">
        @*Background*@
        <img class="hero-background" src="/images/index_images/1.jpg" />

        <div class="hero-content">
            @*Titulo del hero*@
            <h1 class="hero-title">
                D' LEON <br />
                ASOCIADOS
            </h1>

            @*Párrafo del hero*@
            <p>
                Disfruta de la facilidad de encontrar y adquirir el vehículo <br /> perfecto.
            </p>

            @*Botón para navegar a Vehículos*@
            <a class="hero-button" href="">Ver vehículos</a>
        </div>
    </div>
</div>