@page "/vehiculo/agregar"

<PageTitle>Agregar Vehículo | D'Leon Asociados</PageTitle>

<div class="pagina-agregar">

    @* Sidebar *@
    <aside class="sidebar sidebar-dark sidebar-narrow-unfoldable border-end">
        @* Logo *@
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <img src="/images/bmw-2.svg" height="32" alt="D'Leon Asociados" />
            </div>
        </div>

        @* Menú del sidebar *@
        <ul class="sidebar-nav">
            <li class="nav-item">
                <a class="nav-link" href="/dashboard">
                    <i class="nav-icon cil-home"></i>
                    Inicio
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="/vehiculos">
                    <i class="nav-icon cil-car-alt"></i>
                    Vehículos
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/vehiculos">
                    <i class="nav-icon cil-people"></i>
                    Clientes
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="">
                    <i class="nav-icon cil-basket"></i>
                    Repuestos
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="">
                    <i class="nav-icon cil-wrench"></i>
                    Mantenimiento
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="">
                    <i class="nav-icon cil-briefcase"></i>
                    Proveedores
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="">
                    <i class="nav-icon cil-chart"></i>
                    Reportes
                </a>
            </li>
        </ul>

        @* Usuario con menú desplegable *@
        <div class="sidebar-footer">
            <div class="dropdown dropend w-100">
                <a class="btn btn-ghost w-100 d-flex gap-2 p-1 align-items-center"
                   href=""
                   role="button"
                   data-coreui-toggle="dropdown"
                   aria-expanded="false">
                    <div class="avatar avatar-md bg-dark text-white rounded">A</div>
                    <div class="small text-start d-sidebar-narrow-none">
                        <div class="fw-semibold">Administrador</div>
                        <div>admin@dleon.com</div>
                    </div>
                    <i class="nav-icon cil-options ms-auto d-sidebar-narrow-none"></i>
                </a>
                <ul class="dropdown-menu w-100">
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" href="">
                            <i class="cil-user"></i> Perfil
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" href="">
                            <i class="cil-settings"></i> Configuración
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" href="">
                            <i class="cil-account-logout"></i> Cerrar sesión
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </aside>


    <!-- ==============================
         CONTENIDO PRINCIPAL
         ============================== -->
    <main class="contenido">

        <!-- Barra superior -->
        <header class="barra-superior">

            <div class="titulo">
                Agregar Vehículo
            </div>

            <div class="barra-derecha">

                <input class="busqueda"
                       placeholder="🔍 Buscar vehículos, clientes, repuestos..." />

                <span class="notificacion">
                    🔔
                </span>

            </div>

        </header>


        <!-- ==============================
             CONTENIDO DEL FORMULARIO
             ============================== -->
        <div class="contenido-principal">

            <!-- Encabezado -->
            <div class="encabezado-pagina">

                <div>
                    <h1>Agregar Vehículo</h1>

                    <p>
                        Registra un nuevo vehículo en el inventario.
                    </p>
                </div>

                <a href="/vehiculos" class="btn-volver">
                    ← Volver al inventario
                </a>

            </div>


            <!-- ==============================
                 FORMULARIO
                 ============================== -->
            <div class="formulario-card">

                <div class="formulario-header">

                    <h2>Información del vehículo</h2>

                    <p>
                        Completa todos los datos necesarios del vehículo.
                    </p>

                </div>


                <div class="formulario-body">

                    <!-- ==============================
                         INFORMACIÓN BÁSICA
                         ============================== -->
                    <div class="seccion-formulario">

                        <h3>Información básica</h3>

                        <div class="form-grid">

                            <!-- Marca -->
                            <div class="campo">

                                <label for="marca">
                                    Marca
                                    <span>*</span>
                                </label>

                                <select id="marca"
                                        @bind="Marca">

                                    <option value="">
                                        Seleccionar marca
                                    </option>

                                    <option value="Toyota">
                                        Toyota
                                    </option>

                                    <option value="BMW">
                                        BMW
                                    </option>

                                    <option value="Kia">
                                        Kia
                                    </option>

                                    <option value="Honda">
                                        Honda
                                    </option>

                                    <option value="Hyundai">
                                        Hyundai
                                    </option>

                                    <option value="Mercedes-Benz">
                                        Mercedes-Benz
                                    </option>

                                    <option value="Ford">
                                        Ford
                                    </option>

                                </select>

                            </div>


                            <!-- Modelo -->
                            <div class="campo">

                                <label for="modelo">
                                    Modelo
                                    <span>*</span>
                                </label>

                                <input id="modelo"
                                       type="text"
                                       @bind="Modelo"
                                       placeholder="Ej. Hilux" />

                            </div>


                            <!-- Año -->
                            <div class="campo">

                                <label for="anio">
                                    Año
                                    <span>*</span>
                                </label>

                                <input id="anio"
                                       type="number"
                                       @bind="Anio"
                                       placeholder="Ej. 2025" />

                            </div>


                            <!-- Precio -->
                            <div class="campo">

                                <label for="precio">
                                    Precio
                                    <span>*</span>
                                </label>

                                <div class="input-precio">

                                    <span>$</span>

                                    <input id="precio"
                                           type="number"
                                           @bind="Precio"
                                           placeholder="0.00" />

                                </div>

                            </div>


                            <!-- Estado -->
                            <div class="campo">

                                <label for="estado">
                                    Estado
                                    <span>*</span>
                                </label>

                                <select id="estado"
                                        @bind="Estado">

                                    <option value="">
                                        Seleccionar estado
                                    </option>

                                    <option value="Disponible">
                                        Disponible
                                    </option>

                                    <option value="Reservado">
                                        Reservado
                                    </option>

                                    <option value="Vendido">
                                        Vendido
                                    </option>

                                </select>

                            </div>


                            <!-- Tipo -->
                            <div class="campo">

                                <label for="tipo">
                                    Tipo de vehículo
                                    <span>*</span>
                                </label>

                                <select id="tipo"
                                        @bind="Tipo">

                                    <option value="">
                                        Seleccionar tipo
                                    </option>

                                    <option value="Sedán">
                                        Sedán
                                    </option>

                                    <option value="SUV">
                                        SUV
                                    </option>

                                    <option value="Pick-up">
                                        Pick-up
                                    </option>

                                    <option value="Coupé">
                                        Coupé
                                    </option>

                                    <option value="Camioneta">
                                        Camioneta
                                    </option>

                                    <option value="Van">
                                        Van
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- ==============================
                         INFORMACIÓN ADICIONAL
                         ============================== -->
                    <div class="seccion-formulario">

                        <h3>Información adicional</h3>

                        <div class="form-grid">

                            <!-- Color -->
                            <div class="campo">

                                <label for="color">
                                    Color
                                </label>

                                <input id="color"
                                       type="text"
                                       @bind="Color"
                                       placeholder="Ej. Negro" />

                            </div>


                            <!-- Combustible -->
                            <div class="campo">

                                <label for="combustible">
                                    Combustible
                                </label>

                                <select id="combustible"
                                        @bind="Combustible">

                                    <option value="">
                                        Seleccionar combustible
                                    </option>

                                    <option value="Gasolina">
                                        Gasolina
                                    </option>

                                    <option value="Diésel">
                                        Diésel
                                    </option>

                                    <option value="Híbrido">
                                        Híbrido
                                    </option>

                                    <option value="Eléctrico">
                                        Eléctrico
                                    </option>

                                </select>

                            </div>


                            <!-- Transmisión -->
                            <div class="campo">

                                <label for="transmision">
                                    Tipo de transmisión
                                </label>

                                <select id="transmision"
                                        @bind="Transmision">

                                    <option value="">
                                        Seleccionar transmisión
                                    </option>

                                    <option value="Automática">
                                        Automática
                                    </option>

                                    <option value="Manual">
                                        Manual
                                    </option>

                                </select>

                            </div>


                            <!-- Kilometraje -->
                            <div class="campo">

                                <label for="kilometraje">
                                    Kilometraje (km)
                                </label>

                                <input id="kilometraje"
                                       type="number"
                                       @bind="Kilometraje"
                                       placeholder="Ej. 25000" />

                            </div>

                        </div>

                    </div>


                    <!-- ==============================
                         DESCRIPCIÓN
                         ============================== -->
                    <div class="seccion-formulario">

                        <h3>Descripción</h3>

                        <div class="campo campo-completo">

                            <label for="descripcion">
                                Descripción del vehículo
                            </label>

                            <textarea id="descripcion"
                                      @bind="Descripcion"
                                      placeholder="Escribe una descripción del vehículo..."
                                      rows="5">
                            </textarea>

                        </div>

                    </div>


                    <!-- ==============================
                         IMAGEN
                         ============================== -->
                    <div class="seccion-formulario">

                        <h3>Imagen del vehículo</h3>

                        <div class="subir-imagen">

                            <div class="icono-imagen">
                                🖼️
                            </div>

                            <h4>Agregar imagen</h4>

                            <p>
                                Selecciona una imagen del vehículo
                            </p>

                            <label class="btn-subir">

                                Seleccionar imagen

                                <InputFile OnChange="SeleccionarImagen" />

                            </label>

                            @if (!string.IsNullOrEmpty(NombreImagen))
                            {
                                <div class="imagen-seleccionada">
                                    ✓ @NombreImagen
                                </div>
                            }

                        </div>

                    </div>

                </div>


                <!-- ==============================
                     BOTONES
                     ============================== -->
                <div class="formulario-footer">

                    <a href="/vehiculos"
                       class="btn-cancelar">

                        Cancelar

                    </a>

                    <button class="btn-guardar"
                            @onclick="GuardarVehiculo">

                        ✓ Guardar vehículo

                    </button>

                </div>

            </div>

        </div>

    </main>

</div>


@code {

    private string Marca = "";
    private string Modelo = "";
    private int? Anio;
    private decimal? Precio;
    private string Estado = "";
    private string Tipo = "";

    private string Color = "";
    private string Combustible = "";
    private string Transmision = "";
    private int? Kilometraje;

    private string Descripcion = "";

    private string NombreImagen = "";


    private void SeleccionarImagen(
        Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        NombreImagen = e.File.Name;
    }


    private void GuardarVehiculo()
    {
        // Aquí posteriormente conectaremos
        // el formulario con la base de datos.

        Console.WriteLine("Vehículo guardado.");
    }

}