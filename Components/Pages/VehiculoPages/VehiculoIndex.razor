@page "/vehiculos"

<PageTitle>Inventario de Vehículos | D'Leon Asociados</PageTitle>

<div class="pagina">

    <!-- ========================================
         MENU LATERAL
         ======================================== -->

    <aside class="sidebar sidebar-dark sidebar-narrow-unfoldable border-end">

        @* Logo *@
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <img src="/images/bmw-2.svg"
                     height="32"
                     alt="D'Leon Asociados" />
            </div>
        </div>

        @* Menú del sidebar *@
        <ul class="sidebar-nav">
            <li class="nav-item">
                <a class="nav-link" href="/dashboard">
                    <i class="nav-icon cil-home"></i>
                    Inicio
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="/vehiculos">
                    <i class="nav-icon cil-car-alt"></i>
                    Vehículos
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/vehiculos">
                    <i class="nav-icon cil-people"></i>
                    Clientes
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="">
                    <i class="nav-icon cil-basket"></i>
                    Repuestos
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="">
                    <i class="nav-icon cil-wrench"></i>
                    Mantenimiento
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="">
                    <i class="nav-icon cil-briefcase"></i>
                    Proveedores
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="">
                    <i class="nav-icon cil-chart"></i>
                    Reportes
                </a>
            </li>
        </ul>

        @* Usuario con menú desplegable *@
        <div class="sidebar-footer">
            <div class="dropdown dropend w-100">
                <a class="btn btn-ghost w-100 d-flex gap-2 p-1 align-items-center"
                   href=""
                   role="button"
                   data-coreui-toggle="dropdown"
                   aria-expanded="false">
                    <div class="avatar avatar-md bg-dark text-white rounded">
                        A
                    </div>
                    <div class="small text-start d-sidebar-narrow-none">
                        <div class="fw-semibold">
                            Administrador
                        </div>
                        <div>
                            admin@dleon.com
                        </div>
                    </div>
                    <i class="nav-icon cil-options ms-auto d-sidebar-narrow-none"></i>
                </a>
                <ul class="dropdown-menu w-100">
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" href="">
                            <i class="cil-user"></i>
                            Perfil
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" href="">
                            <i class="cil-settings"></i>
                            Configuración
                        </a>
                    </li>
                    <li>
                        <hr class="dropdown-divider">
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" href="">
                            <i class="cil-account-logout"></i>
                            Cerrar sesión
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </aside>


    <!-- ========================================
         CONTENIDO PRINCIPAL
         ======================================== -->

    <main class="contenido">

        <!-- BARRA SUPERIOR -->

        <header class="barra-superior">

            <div class="titulo">
                Inventario de Vehículos
            </div>

            <div>

                <input class="busqueda"
                       placeholder="🔍 Buscar vehículos, clientes, repuestos..." />

                <span class="notificacion">
                    🔔
                </span>

            </div>

        </header>


        <!-- CONTENIDO -->

        <div class="contenido-principal">


            <!-- BOTONES -->

            <div class="acciones">

                <a class="btn-agregar" href="/vehiculo/agregar">
                    ＋ Agregar Vehículo
                </a>

                <button class="btn-exportar">
                    ↗ Exportar Excel
                </button>

            </div>


            <!-- FILTROS -->

            <div class="filtros">

                <div class="filtro">

                    <label>
                        Marca
                    </label>

                    <select>

                        <option>
                            Todas las marcas
                        </option>

                        <option>
                            Toyota
                        </option>

                        <option>
                            BMW
                        </option>

                        <option>
                            Kia
                        </option>

                    </select>

                </div>


                <div class="filtro">

                    <label>
                        Estado
                    </label>

                    <select>

                        <option>
                            Disponible / Reservado
                        </option>

                        <option>
                            Disponible
                        </option>

                        <option>
                            Reservado
                        </option>

                    </select>

                </div>


                <div class="filtro">

                    <label>
                        Rango de Año
                    </label>

                    <select>

                        <option>
                            2020 - 2027
                        </option>

                        <option>
                            2020 - 2023
                        </option>

                        <option>
                            2024 - 2027
                        </option>

                    </select>

                </div>


                <div class="filtro">

                    <label>
                        Rango de Precio
                    </label>

                    <select>

                        <option>
                            Cualquier precio
                        </option>

                        <option>
                            Menos de $30,000
                        </option>

                        <option>
                            $30,000 - $60,000
                        </option>

                        <option>
                            Más de $60,000
                        </option>

                    </select>

                </div>

            </div>


