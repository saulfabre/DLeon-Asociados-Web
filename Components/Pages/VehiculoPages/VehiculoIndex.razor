<!-- ========================================
     MODAL DE DETALLE
     ======================================== -->

<VehiculoDetalleModal
    Visible="@MostrarModal"
    VisibleChanged="@ModalCerrado"
    Marca="@MarcaSeleccionada"
    Modelo="@ModeloSeleccionado"
    Anio="@AnioSeleccionado"
    Estado="@EstadoSeleccionado"
    Descripcion="@DescripcionSeleccionada"
    ImagenPrincipal="@ImagenSeleccionada"
    Imagenes="@ImagenesSeleccionadas" />


@code {

    private bool MostrarModal = false;

    private string MarcaSeleccionada = "";
    private string ModeloSeleccionado = "";
    private string AnioSeleccionado = "";
    private string EstadoSeleccionado = "";
    private string DescripcionSeleccionada = "";
    private string ImagenSeleccionada = "";
    private string[] ImagenesSeleccionadas = Array.Empty<string>();

    private readonly string[] ToyotaHiluxImagenes =
    {
        "/images/vehiculos/toyota-hilux.jpg",
        "/images/vehiculos/toyota-hilux-frente.jpeg",
        "/images/vehiculos/toyota-hilux-lateral.jpeg",
        "/images/vehiculos/toyota-hilux-trasera.jpeg",
        "/images/vehiculos/toyota-hilux-interior.jpeg"
    };

    private readonly string[] Toyota4RunnerImagenes =
    {
        "/images/vehiculos/toyota-4runner.jpg"
    };

    private readonly string[] ToyotaTacomaImagenes =
    {
        "/images/vehiculos/toyota-tacoma.webp"
    };

    private readonly string[] ToyotaCorollaImagenes =
    {
        "/images/vehiculos/toyota-corolla.webp"
    };

    private readonly string[] BmwX7Imagenes =
    {
        "/images/vehiculos/bmw-x7.jpg"
    };

    private readonly string[] KiaK5Imagenes =
    {
        "/images/vehiculos/kia-k5.jpeg"
    };


    private void AbrirModal(
        string marca,
        string modelo,
        string anio,
        string estado,
        string descripcion,
        string imagen,
        string[] imagenes)
    {
        MarcaSeleccionada = marca;
        ModeloSeleccionado = modelo;
        AnioSeleccionado = anio;
        EstadoSeleccionado = estado;
        DescripcionSeleccionada = descripcion;
        ImagenSeleccionada = imagen;
        ImagenesSeleccionadas = imagenes;

        MostrarModal = true;
    }


    private void ModalCerrado(bool valor)
    {
        MostrarModal = valor;
    }

}