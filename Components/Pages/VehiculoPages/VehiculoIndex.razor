@page "/vehiculos"

<PageTitle>Inventario de Vehículos</PageTitle>

<style>

    .pagina {
        display: flex;
        min-height: 100vh;
        background-color: #f5f7fa;
        font-family: Arial, sans-serif;
    }

    /* MENÚ LATERAL */
    .sidebar {
        width: 250px;
        background-color: #101a2d;
        color: white;
        padding: 20px 15px;
    }

    .logo {
        font-size: 17px;
        font-weight: bold;
        margin-bottom: 3px;
    }

    .subtitulo {
        font-size: 9px;
        color: #d0d5df;
        margin-bottom: 25px;
    }

    .menu {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .menu-item {
        padding: 11px 12px;
        border-radius: 6px;
        color: #d8deea;
        text-decoration: none;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .menu-item:hover {
        background-color: #1d2a43;
        color: white;
    }

    .menu-item.activo {
        background-color: #2864e8;
        color: white;
    }

    .usuario {
        margin-top: 30px;
        border-top: 1px solid #273249;
        padding-top: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .avatar {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background-color: #bd8a6c;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: bold;
    }

    .usuario-nombre {
        font-size: 12px;
        font-weight: bold;
    }

    .usuario-tipo {
        font-size: 10px;
        color: #aeb7c7;
    }


    /* CONTENIDO */
    .contenido {
        flex: 1;
        padding: 0;
    }

    .barra-superior {
        height: 60px;
        background-color: white;
        border-bottom: 1px solid #e2e6ec;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 25px;
    }

    .titulo {
        font-size: 17px;
        font-weight: bold;
        color: #172033;
    }

    .busqueda {
        width: 180px;
        height: 32px;
        border: none;
        background-color: #f1f4f8;
        border-radius: 6px;
        padding: 0 12px;
        font-size: 11px;
    }

    .notificacion {
        margin-left: 10px;
        font-size: 18px;
    }

    .contenido-principal {
        padding: 20px;
    }

    /* BOTONES */
    .acciones {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
    }

    .btn-agregar {
        background-color: #2864e8;
        color: white;
        border: none;
        border-radius: 6px;
        padding: 9px 14px;
        font-size: 12px;
        cursor: pointer;
    }

    .btn-exportar {
        background-color: white;
        border: 1px solid #dce1e8;
        border-radius: 6px;
        padding: 9px 14px;
        font-size: 12px;
        cursor: pointer;
    }


    /* FILTROS */
    .filtros {
        background-color: white;
        border: 1px solid #e1e5eb;
        border-radius: 8px;
        padding: 14px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 20px;
    }

    .filtro label {
        display: block;
        font-size: 10px;
        color: #4f5b6d;
        margin-bottom: 6px;
    }

    .filtro select {
        width: 100%;
        height: 34px;
        border: 1px solid #dce1e8;
        border-radius: 5px;
        padding: 0 8px;
        font-size: 11px;
        color: #364052;
        background-color: white;
    }


    /* TARJETAS */
    .vehiculos {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 35px;
    }

    .vehiculo {
        background-color: white;
        border: 1px solid #dfe3e9;
        border-radius: 5px;
        overflow: hidden;
    }

    .imagen-vehiculo {
        width: 100%;
        height: 165px;
        object-fit: cover;
        display: block;
    }

    .informacion {
        padding: 10px;
    }

    .datos {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 7px;
    }

    .marca {
        font-size: 11px;
        font-weight: bold;
        color: #202938;
    }

    .ano {
        font-size: 10px;
        color: #586274;
        margin-left: 8px;
    }

    .precio {
        font-size: 11px;
        font-weight: bold;
        color: #111827;
    }

    .parte-inferior {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .disponible {
        background-color: #d8f8e5;
        color: #19a55a;
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 9px;
    }

    .botones {
        display: flex;
        gap: 5px;
    }

    .btn-editar,
    .btn-eliminar {
        width: 25px;
        height: 25px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    .btn-editar {
        background-color: #edf1f6;
        color: #43536b;
    }

    .btn-eliminar {
        background-color: #ffe1e1;
        color: #f44343;
    }


    /* RESPONSIVE */
    @@media (max-width: 1000px) {

    .sidebar {
        width: 200px;
    }

    .vehiculos {
        grid-template-columns: repeat(2, 1fr);
    }

    .filtros {
        grgit branchid-template-columns: repeat(2, 1fr);
    }
}

    @@media (max-width: 700px) {

    .sidebar {
        display: none;
    }

    .vehiculos {
        grid-template-columns: 1fr;
    }

    .filtros {
        grid-template-columns: 1fr;
    }
}

</style>


