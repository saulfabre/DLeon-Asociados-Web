<VehiculoDetalleModal 
    Visible="@MostrarModal"
    VisibleChanged="@(valor => MostrarModal = valor)"
    Marca="Toyota"
    Modelo="Hilux"
    Anio="2027"
    Estado="Disponible"
    Descripcion="La Toyota Hilux Travo-e 2027 es una camioneta pick-up 100% eléctrica (BEV) que maximiza la resistencia tradicional de la línea Hilux con tecnología de movilidad sostenible." />

    @code{
        private bool MostrarModal = false;

        private void AbrirModal()
        {
            MostrarModal = true;
        }
        
        private void ModalCerrado(bool valor)
        {
            MostrarModal = valor;
        }
    }