@if (Visible)
{
    <div class="modal-fondo">

        <div class="modal-vehiculo">

            <!-- BOTÓN CERRAR -->
            <button class="btn-cerrar" @onclick="Cerrar">
                ✕
            </button>


            <!-- PARTE SUPERIOR -->
            <div class="contenido-superior">

                <!-- GALERÍA -->
                <div class="galeria">

                    <img class="imagen-principal"
                         src="@Imagenes[ImagenActual]"
                         alt="@Modelo" />

                    <!-- FLECHA IZQUIERDA -->
                    <button class="flecha izquierda"
                            @onclick="ImagenAnterior">
                        ‹
                    </button>

                    <!-- FLECHA DERECHA -->
                    <button class="flecha derecha"
                            @onclick="ImagenSiguiente">
                        ›
                    </button>


                    <!-- INDICADORES -->
                    <div class="indicadores">

                        @for (int i = 0; i < Imagenes.Length; i++)
                        {
                            int indice = i;

                            <button class="indicador @(ImagenActual == indice ? "activo" : "")"
                                    @onclick="() => SeleccionarImagen(indice)">
                            </button>
                        }

                    </div>

                </div>


                <!-- INFORMACIÓN -->
                <div class="informacion">

                    <div class="campo">

                        <span>Marca de vehículo</span>

                        <strong>
                            @Marca
                        </strong>

                    </div>


                    <div class="campo">

                        <span>Modelo</span>

                        <strong>
                            @Modelo
                        </strong>

                    </div>


                    <div class="campo">

                        <span>Año del vehículo</span>

                        <strong>
                            @Anio
                        </strong>

                    </div>


                    <div class="campo">

                        <span>Estado del vehículo</span>

                        <span class="estado">
                            @Estado
                        </span>

                    </div>


                    <!-- ELIMINAR -->
                    <div class="accion-eliminar">

                        <span>
                            Eliminar vehículo
                        </span>

                        <button class="btn-eliminar"
                                @onclick="Eliminar">
                            🗑
                        </button>

                    </div>

                </div>

            </div>


            <!-- DESCRIPCIÓN -->
            <div class="descripcion">

                <h3>
                    Descripción
                </h3>

                <p>
                    @Descripcion
                </p>

            </div>


            <!-- BOTÓN EDITAR -->
            <button class="btn-editar"
                    @onclick="Editar">

                ✎

            </button>

        </div>

    </div>
}


@code {

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }


    [Parameter]
    public string Marca { get; set; } = "Toyota";

    [Parameter]
    public string Modelo { get; set; } = "Hilux";

    [Parameter]
    public int Anio { get; set; } = 2027;

    [Parameter]
    public string Estado { get; set; } = "Disponible";

    [Parameter]
    public string Descripcion { get; set; } =
        "Descripción La Toyota Hilux Travo-e 2027 es una camioneta pick-up 100% eléctrica (BEV) que maximiza la resistencia tradicional de la línea Hilux con tecnología de movilidad sostenible.";

    
    /*
     * IMÁGENES DEL VEHÍCULO
     *
     * Estas imágenes deben estar en:
     *
     * wwwroot/images/vehiculos/
     */

    private string[] Imagenes =
    {
        "/images/vehiculos/toyota-hilux.jpg",
        "/images/vehiculos/toyota-hilux-frente.jpg",
        "/images/vehiculos/toyota-hilux-lateral.jpg",
        "/images/vehiculos/toyota-hilux-trasera.jpg",
        "/images/vehiculos/toyota-hilux-interior.jpg"
    };


    private int ImagenActual = 0;


    private void ImagenSiguiente()
    {
        ImagenActual++;

        if (ImagenActual >= Imagenes.Length)
        {
            ImagenActual = 0;
        }
    }


    private void ImagenAnterior()
    {
        ImagenActual--;

        if (ImagenActual < 0)
        {
            ImagenActual = Imagenes.Length - 1;
        }
    }


    private void SeleccionarImagen(int indice)
    {
        ImagenActual = indice;
    }


    private async Task Cerrar()
    {
        Visible = false;

        await VisibleChanged.InvokeAsync(false);
    }


    private void Editar()
    {
        // Aquí posteriormente podemos colocar
        // la navegación a Editar Vehículo.

    }


    private void Eliminar()
    {
        // Aquí posteriormente podemos colocar
        // la eliminación del vehículo.

    }

    private bool MostrarModal = false;

    private void AbrirModal()
    {
        MostrarModal = true;
    }
    
    private void ModalCerrado(bool valor)
    {
        MostrarModal = valor;
    }

}

<style>

    /* FONDO DEL MODAL */

    .modal-fondo {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;

        background-color: rgba(0, 0, 0, 0.55);

        display: flex;
        justify-content: center;
        align-items: center;

        z-index: 9999;

        padding: 20px;
    }


    /* MODAL */

    .modal-vehiculo {
        width: 720px;
        max-width: 95%;

        background-color: white;

        border-radius: 18px;

        padding: 10px;

        position: relative;

        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);

        border: 2px solid #6838ef;
    }


    /* BOTÓN CERRAR */

    .btn-cerrar {
        position: absolute;

        right: 10px;
        top: 8px;

        width: 22px;
        height: 22px;

        border-radius: 50%;

        border: 2px solid #222;

        background-color: white;

        font-size: 13px;

        cursor: pointer;

        z-index: 10;

        display: flex;
        align-items: center;
        justify-content: center;
    }


    .btn-cerrar:hover {
        background-color: #eeeeee;
    }


    /* PARTE SUPERIOR */

    .contenido-superior {
        display: grid;

        grid-template-columns: 3fr 1.15fr;

        gap: 18px;

        margin-top: 3px;
    }


    /* GALERÍA */

    .galeria {
        height: 310px;

        position: relative;

        overflow: hidden;

        border-radius: 16px;

        background-color: #e9edf2;
    }


    .imagen-principal {
        width: 100%;
        height: 100%;

        object-fit: cover;

        display: block;
    }


    /* FLECHAS */

    .flecha {
        position: absolute;

        top: 50%;

        transform: translateY(-50%);

        border: none;

        background-color: transparent;

        color: white;

        font-size: 48px;

        cursor: pointer;

        text-shadow: 0 1px 5px black;

        z-index: 5;
    }


    .flecha:hover {
        transform: translateY(-50%) scale(1.15);
    }


    .izquierda {
        left: 5px;
    }


    .derecha {
        right: 5px;
    }


    /* INDICADORES */

    .indicadores {
        position: absolute;

        bottom: 8px;

        left: 0;

        right: 0;

        display: flex;

        justify-content: center;

        gap: 12px;
    }


    .indicador {
        width: 12px;
        height: 12px;

        border-radius: 50%;

        border: none;

        background-color: #dddddd;

        cursor: pointer;
    }


    .indicador.activo {
        background-color: #2878ee;
    }


    /* INFORMACIÓN */

    .informacion {
        padding: 18px 5px 0 0;

        display: flex;

        flex-direction: column;

        gap: 15px;
    }


    .campo {
        display: flex;

        flex-direction: column;

        gap: 2px;
    }


    .campo span:first-child {
        font-size: 14px;

        color: #777777;
    }


    .campo strong {
        font-size: 15px;

        color: #111111;
    }


    /* ESTADO */

    .estado {
        width: fit-content;

        background-color: #d8f8e5;

        color: #18a957;

        border-radius: 15px;

        padding: 4px 9px;

        font-size: 12px;

        font-weight: 500;
    }


    /* ELIMINAR */

    .accion-eliminar {
        display: flex;

        flex-direction: column;

        gap: 7px;

        margin-top: 4px;
    }


    .accion-eliminar span {
        font-size: 14px;

        color: #555;
    }


    .btn-eliminar {
        width: 34px;
        height: 34px;

        border: none;

        border-radius: 7px;

        background-color: #ffe1e1;

        color: #ef3838;

        cursor: pointer;

        font-size: 16px;
    }


    .btn-eliminar:hover {
        background-color: #ffcaca;
    }


    /* DESCRIPCIÓN */

    .descripcion {
        padding: 5px 12px 5px 12px;
    }


    .descripcion h3 {
        margin: 0;

        font-size: 16px;

        color: #111111;
    }


    .descripcion p {
        margin: 3px 0 0 0;

        font-size: 14px;

        line-height: 1.3;

        color: #858585;

        font-weight: 500;
    }


    /* EDITAR */

    .btn-editar {
        position: absolute;

        right: 15px;

        bottom: 88px;

        width: 34px;
        height: 34px;

        border: none;

        border-radius: 7px;

        background-color: #eeeeee;

        color: #555;

        cursor: pointer;

        font-size: 17px;
    }


    .btn-editar:hover {
        background-color: #dddddd;
    }


    /* RESPONSIVE */

    @@media (max-width: 700px) {

        .contenido-superior {
            grid-template-columns: 1fr;
        }

        .galeria {
            height: 250px;
        }

        .informacion {
            padding: 5px 10px;
        }

        .modal-vehiculo {
            max-height: 95vh;

            overflow-y: auto;
        }

    }

</style>