@page "/dashboard"

@rendermode InteractiveServer

<HeadContent>
    <link href="https://cdn.jsdelivr.net/npm/@@coreui/coreui@5.9.0/dist/css/coreui.min.css" rel="stylesheet"
          integrity="sha384-9DZ6o3pJWcTwBR8W196XizUEf2kNMD35tkeyWqOB0yzml+nZrEe/13PMCpAIrT4r" crossorigin="anonymous">
    <link rel="stylesheet" href="https://unpkg.com/@@coreui/icons/css/free.min.css">
</HeadContent>

<PageTitle>Dashboard | D'Leon Asociados</PageTitle>

@*Sidebar*@
<div class="sidebar sidebar-gray sidebar-narrow-unfoldable border-end">

    @*Logo*@
    <div class="sidebar-header">
        <div class="sidebar-brand">
            <img src="/images/bmw-2.svg" height="32" alt="D'Leon Asociados" />
        </div>
    </div>

    @*Menú del sidebar*@
    <ul class="sidebar-nav">
        <li class="nav-item">
            <a class="nav-link active" href="/dashboard">
                <i class="nav-icon cil-home"></i>
                Inicio
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="/vehiculos">
                <i class="nav-icon cil-car-alt"></i>
                Vehículos
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="">
                <i class="nav-icon cil-people"></i>
                Clientes
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="">
                <i class="nav-icon cil-basket"></i>
                Repuestos
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="">
                <i class="nav-icon cil-wrench"></i>
                Mantenimiento
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="">
                <i class="nav-icon cil-briefcase"></i>
                Proveedores
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="">
                <i class="nav-icon cil-chart"></i>
                Reportes
            </a>
        </li>
    </ul>

    @*Usuario con menú desplegable*@
    <div class="sidebar-footer">
        <div class="dropdown dropend w-100">
            <a class="btn btn-ghost w-100 d-flex gap-2 p-1 align-items-center" href="#" role="button"
               data-coreui-toggle="dropdown" aria-expanded="false">
                <div class="avatar avatar-md bg-dark text-white rounded">
                    A
                </div>
                <div class="small text-start d-sidebar-narrow-none">
                    <div class="fw-semibold">
                        Administrador
                    </div>
                    <div>
                        admin@dleon.com
                    </div>
                </div>
                <i class="nav-icon cil-options ms-auto d-sidebar-narrow-none"></i>
            </a>
            <ul class="dropdown-menu w-100">
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" href="#">
                        <i class="cil-user"></i>
                        Perfil
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" href="#">
                        <i class="cil-settings"></i>
                        Configuración
                    </a>
                </li>
                <li>
                    <hr class="dropdown-divider">
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" href="/">
                        <i class="cil-account-logout"></i>
                        Cerrar sesión
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>