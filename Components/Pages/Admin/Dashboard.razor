@page "/dashboard"

@rendermode InteractiveServer

<PageTitle>Dashboard | D'Leon Asociados</PageTitle>

@* ========================================
   SIDEBAR
   ======================================== *@

<div class="sidebar sidebar-dark sidebar-narrow-unfoldable border-end">

    @* Logo *@
    <div class="sidebar-header">
        <div class="sidebar-brand">
            <img src="/images/bmw-2.svg"
                 height="32"
                 alt="D'Leon Asociados" />
        </div>
    </div>

    @* ========================================
       MENÚ DEL SIDEBAR
       ======================================== *@

    <ul class="sidebar-nav">

        @* Inicio *@
        <li class="nav-item">
            <a class="nav-link active"
               href="/dashboard">
                <i class="nav-icon cil-home"></i>
                Inicio
            </a>
        </li>

        @* Vehículos *@
        <li class="nav-item">
            <a class="nav-link"
               href="/vehiculos">
                <i class="nav-icon cil-car-alt"></i>
                Vehículos
            </a>
        </li>

        @* Clientes *@
        <li class="nav-item">
            <a class="nav-link"
               href="/vehiculos">
                <i class="nav-icon cil-people"></i>
                Clientes
            </a>
        </li>

        @* Repuestos *@
        <li class="nav-item">
            <a class="nav-link"
               href="">
                <i class="nav-icon cil-basket"></i>
                Repuestos
            </a>
        </li>

        @* Mantenimiento *@
        <li class="nav-item">
            <a class="nav-link"
               href="">
                <i class="nav-icon cil-wrench"></i>
                Mantenimiento
            </a>
        </li>

        @* Proveedores *@
        <li class="nav-item">
            <a class="nav-link"
               href="">
                <i class="nav-icon cil-briefcase"></i>
                Proveedores
            </a>
        </li>

        @* Reportes *@
        <li class="nav-item">
            <a class="nav-link"
               href="">
                <i class="nav-icon cil-chart"></i>
                Reportes
            </a>
        </li>

    </ul>

    @* ========================================
       USUARIO
       ======================================== *@

    <div class="sidebar-footer">

        <div class="dropdown dropend w-100">

            <a class="btn btn-ghost w-100 d-flex gap-2 p-1 align-items-center"
               href=""
               role="button"
               data-coreui-toggle="dropdown"
               aria-expanded="false">

                <div class="avatar avatar-md bg-dark text-white rounded">
                    A
                </div>

                <div class="small text-start d-sidebar-narrow-none">

                    <div class="fw-semibold">
                        Administrador
                    </div>

                    <div>
                        admin@dleon.com
                    </div>

                </div>

                <i class="nav-icon cil-options ms-auto d-sidebar-narrow-none"></i>

            </a>

            <ul class="dropdown-menu w-100">

                @* Perfil *@
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2"
                       href="">
                        <i class="cil-user"></i>
                        Perfil
                    </a>
                </li>

                @* Configuración *@
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2"
                       href="">
                        <i class="cil-settings"></i>
                        Configuración
                    </a>
                </li>

                <li>
                    <hr class="dropdown-divider">
                </li>

                @* Cerrar sesión *@
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2"
                       href="">
                        <i class="cil-account-logout"></i>
                        Cerrar sesión
                    </a>
                </li>

            </ul>

        </div>

    </div>

</div>